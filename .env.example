# Server-wide environment configuration
# Copy this file to .env and fill in real values
# NEVER commit .env to git

# ===========================================
# SHARED SECRETS (used by multiple apps)
# ===========================================

# JWT secret for authentication (shared across artanis, gamenight, fantasy-hawk)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here

# ===========================================
# ARTANIS (Auth Service)
# ===========================================

# Mailgun API credentials for sending emails
MAILGUN_API_KEY=your-mailgun-api-key

# ===========================================
# FANTASY HAWK (Yahoo Fantasy Sports)
# ===========================================

# Yahoo OAuth credentials from https://developer.yahoo.com/apps/
YAHOO_CLIENT_ID=your-yahoo-client-id
YAHOO_CLIENT_SECRET=your-yahoo-client-secret

# ===========================================
# YAHOO FANTASY MCP SERVER
# ===========================================

# Encryption key for Yahoo tokens at rest (AES-256)
# Generate with: openssl rand -base64 32
MCP_TOKEN_ENCRYPTION_KEY=your-encryption-key-here

# Secret for MCP token generation
# Generate with: openssl rand -base64 32
MCP_TOKEN_SECRET=your-mcp-token-secret-here

# Cabinet web push (VAPID, RFC 8292). Generate once with:
#   npx tsx -e "import('./apps/cabinet/server/src/push/webpush.js').then(m=>console.log(m.generateVapidKeys()))"
# Rotating these silently invalidates every existing browser subscription.
CABINET_VAPID_PUBLIC_KEY=
CABINET_VAPID_PRIVATE_KEY=
CABINET_VAPID_SUBJECT=mailto:you@example.com

# sleeper-ui: optional server-wide Sleeper token. Visitors can instead connect
# their own account from the Chat page, which is the normal path.
SLEEPER_TOKEN=
# Sleeper sign-in. 'false' closes it entirely; SLEEPER_LOGIN_ALLOW restricts it
# to a comma-separated list of Sleeper usernames (the handle, not the display
# name). Production is set to the dynasty league roster. Leaving this empty means
# ANY visitor may enter Sleeper credentials on a public page.
SLEEPER_LOGIN_ENABLED=true
SLEEPER_LOGIN_ALLOW=
# Sending messages writes to a real league. Off unless explicitly set to true.
SLEEPER_ALLOW_POSTING=false
