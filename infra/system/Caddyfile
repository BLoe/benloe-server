# Main Caddyfile for benloe.com and subdomains

# Root domain
benloe.com {
	# Root-owned copy of static/benloe.com, made by
	# `cabinet-privops publish-static home`. Never serve the source directly:
	# claude-worker owns it, and file_server follows symlinks.
	root * /var/www/benloe/home
	file_server
	encode gzip
}

# www redirect
www.benloe.com {
	redir https://benloe.com{uri} permanent
}

# Import subdomain configurations from monorepo
import /etc/caddy/secure.d/*
import /srv/benloe/infra/caddy/*
