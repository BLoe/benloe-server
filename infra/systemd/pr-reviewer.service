[Unit]
Description=Review new open PRs on BLoe/benloe-server with Claude
Documentation=file:///srv/benloe/apps/pr-reviewer/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runs as root because the Claude CLI credentials and the pr-review-toolkit
# plugin both live under /root/.claude. That is a real concentration of
# authority, so the sandbox below — not the uid — is what bounds this service.
#
# THE THREAT: this repository is PUBLIC, so anyone can open a pull request, and
# a PR's title/body/diff are attacker-controlled text that reaches the agent's
# prompt. The agent's output is then published to that same public PR. Without
# the mount-namespace fencing below, that is a complete
# stranger-to-published-secrets path. prompts/orchestrator.md fences the untrusted text, but a prompt fence
# is advisory; this is the part that is enforced by the kernel.
User=root
WorkingDirectory=/srv/benloe/apps/pr-reviewer
ExecStart=/usr/bin/env node /srv/benloe/apps/pr-reviewer/src/poll.mjs

# --- Sandbox -----------------------------------------------------------------
NoNewPrivileges=yes
# Everything is read-only except the two trees this service legitimately writes:
# its own state/worktrees, and its log.
ProtectSystem=strict
# /srv/benloe is NOT here on purpose. It is the live production checkout, and
# the reviewer keeps its own bare mirror under /var/lib/pr-reviewer instead —
# see ensureMirror() in src/review.mjs. Adding it back would let a reviewer
# mutate production git state to read a diff.
ReadWritePaths=/var/lib/pr-reviewer /srv/benloe/logs /root/.claude /tmp
# The secrets the reviewer must never be able to read, even though it runs as
# root and even if the agent is talked into trying.
#
# File modes are not the control here and cannot be: 0400 benloe-secrets stops
# every other uid on this box and stops a root unit not at all. The mount
# namespace is what actually binds this service.
#
# /run/benloe-secrets holds ONE RENDER PER APP, and the reviewer legitimately
# needs one of them — its own.
#
# Binding that one file in read-only was the first attempt and it FAILS, for a
# reason worth recording: the render is 0400 and owned by the benloe-secrets
# uid, and CapabilityBoundingSet= below is empty, so this unit is root WITHOUT
# CAP_DAC_OVERRIDE. Being uid 0 does not open a file the mode bits refuse once
# that capability is gone. The old /srv/benloe/.env happened to work only
# because it was owned by root.
#
# LoadCredential= is the mechanism that fits: PID 1 opens the file during unit
# setup, in the host context, before any of this sandbox exists, and leaves a
# private 0400 copy in $CREDENTIALS_DIRECTORY owned by this service. The whole
# render directory can then be made inaccessible, so the reviewer cannot even
# observe that the other twelve apps' renders exist — and that holds BY DEFAULT
# for an app added tomorrow, with no edit to this unit. A deny-list would have
# to be maintained, and forgetting an entry fails silently open.
LoadCredential=reviewer-env:/run/benloe-secrets/pr-reviewer.env
#
# So poll.mjs authenticates with the three PR_REVIEWER_* keys in its own set and
# nothing else — the worst a successful injection can publish to a public PR is
# a credential that already only holds pull_requests:write on this one repo.
# This is the enforcement; the fence in prompts/orchestrator.md is advisory and
# rides on top of it.
#
# No leading `-` on the LoadCredential source: without the render the reviewer
# cannot authenticate at all, and failing at unit start beats a run that reaches
# a PR before it discovers it has no credentials.
#
# The remaining denials, and why each one is not already covered above:
#   /run/benloe-secrets      every OTHER app's render. The reviewer's own copy
#                            arrives via LoadCredential, so it needs nothing from
#                            this directory and is denied all of it.
#   /var/lib/benloe-secrets  the store the renders come FROM (secrets.db + audit
#                            log). Reading it defeats every per-app scope at once.
#   /run/benloe-secrets-broker  the broker socket. It hands out no key, but it
#                            will make authenticated calls on behalf of whoever
#                            can connect, which is a capability, not a file.
#   /srv/benloe/data, /var/lib/artanis  application databases — sessions and
#                            tokens live there, not only in the secret store.
#   /etc/benloe, /root/.ssh  the ecosystem configs that name what gets injected,
#                            and the deploy key.
#
# The `-` prefixes mark paths that legitimately may not exist: /srv/benloe/.env
# is deleted once every service reads its render, and the broker socket dir only
# appears while the broker runs. Without them, absence would stop the unit.
InaccessiblePaths=/run/benloe-secrets /srv/benloe/data /var/lib/benloe-secrets /var/lib/artanis /etc/benloe /root/.ssh -/run/benloe-secrets-broker -/srv/benloe/.env
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
# The agent has no business as any other user; it reads files and talks to two
# HTTPS endpoints.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

# Must exceed RUN_BUDGET_MS + 2*GIT_TIMEOUT_MS + PR_REVIEWER_TIMEOUT_MS, which
# is the true worst case (see RUN_BUDGET_MS in src/poll.mjs): the budget is
# checked only before STARTING a review, so the last one can begin at
# budget-1ms and then run its full 40 minutes. With the defaults that is
# 25 + 10 + 20 + 10 = 65min, so 90 leaves real margin.
#
# It matters because a SIGKILL here runs no catch and no finally: every
# in-flight review would die without posting anything to any PR. systemd will
# not start a second instance while this one runs, which is the concurrency
# guard.
TimeoutStartSec=90min
StandardOutput=append:/srv/benloe/logs/pr-reviewer.log
StandardError=append:/srv/benloe/logs/pr-reviewer.log
# node and the claude CLI both resolve from these; there is deliberately no nvm
# path here, because this unit must not depend on a per-user node install.
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/root

[Install]
WantedBy=multi-user.target
