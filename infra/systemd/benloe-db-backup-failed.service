# Started by benloe-db-backup.service when it fails (OnFailure=). It does not
# send anything to anyone: there is no alerting on this box to hand it to. It
# leaves a file that says the last backup failed, which the next clean run of
# the backup removes, and an error-priority line in the journal.
#   ls /var/backups/benloe/LAST-RUN-FAILED
#   journalctl -t benloe-db-backup -p err
# Installed by infra/scripts/install-db-backup.sh, through benloe-promote.
[Unit]
Description=Record that the nightly database backup failed

[Service]
Type=oneshot
UMask=0077
ExecStart=/bin/sh -c 'mkdir -p /var/backups/benloe && date -u +"failed %%FT%%TZ; see /var/log/benloe-db-backup.log" > /var/backups/benloe/LAST-RUN-FAILED'
ExecStart=/usr/bin/logger -p daemon.err -t benloe-db-backup "the nightly database backup failed; see /var/log/benloe-db-backup.log"
