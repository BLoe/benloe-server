[Unit]
Description=Render benloe-secrets to /run before services start
Documentation=file:///srv/benloe/docs/SECRETS.md
# THE ORDERING IS THE WHOLE POINT OF THIS UNIT.
#
# /run is tmpfs, so after a reboot the rendered env files do not exist. PM2
# resurrects thirteen services at once and each reads its configuration from a
# path under /run/benloe-secrets. If the renderer were just another PM2 app it
# would be racing its own consumers, and the failure mode is a few services
# quietly starting with no credentials — which looks like an application bug,
# days later, in whichever integration happened to lose the race.
#
# systemd-tmpfiles-setup creates the directory; this writes the files into it;
# only then may PM2 start.
After=systemd-tmpfiles-setup.service
Requires=systemd-tmpfiles-setup.service
Before=pm2-root.service
RequiredBy=pm2-root.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Root starts it, but the shim drops to the benloe-secrets uid before node
# evaluates a single line, so the key is never held by a root process.
ExecStart=/usr/local/lib/benloe/node-as-benloe-secrets /srv/benloe/apps/benloe-secrets/dist/render-cli.js
StandardOutput=append:/srv/benloe/logs/benloe-secrets-render.log
StandardError=append:/srv/benloe/logs/benloe-secrets-render.log
# A fresh install with nothing stored exits 0 with a warning; a real failure
# (missing key, corrupt row) exits 1 and must be loud rather than letting the
# box come up half-configured.
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
